"VertexLitGeneric"
{
	"$basetexture" "models/metrostroi_train/dev4you_5p/5p_cabin_3"
	"$model" "1"
	"$phong" "1"
 
	"$bumpmap"				"models/metrostroi_train/dev4you_5p/5p_cabin_3_n"
	"$phongboost"				1
	"$phongfresnelranges"		"[0.2 0.2 0.2]"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .05 .05 .05 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "1"
	"$envmapFresnel" "1"
	$normalmapalphaenvmapmask 1
}