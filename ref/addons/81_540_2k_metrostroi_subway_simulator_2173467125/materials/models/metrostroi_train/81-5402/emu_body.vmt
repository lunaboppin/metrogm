"VertexLitGeneric"
{
	"$basetexture" "models/metrostroi_train/81-5402/emu_body"
	"$model" "1"
	"$phong" "1"
	
	$envmap			env_cubemap
	"$phongboost"				1
	"$phongfresnelranges"		"[1 1 1]"
	"$envmaptint" "[ .2 .2 .2 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
	"$envmapFresnel" "1"
	$normalmapalphaenvmapmask 1
}