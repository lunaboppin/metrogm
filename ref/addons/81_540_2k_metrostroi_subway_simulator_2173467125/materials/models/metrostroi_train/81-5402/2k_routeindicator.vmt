"VertexLitGeneric"
{
	"$basetexture" "models/metrostroi_train/81-5402/2k_routeindicator"
	"$model" "1"

	"$phong" "1"
 
	"$bumpmap"				"models/metrostroi_train/81-5402/2k_routeindicator_n"
	"$phongboost"				1
	"$phongfresnelranges"		"[0.2 0.2 0.2]"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .05 .05 .05 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "1"
	"$envmapFresnel" "0"
	$normalmapalphaenvmapmask 1
}