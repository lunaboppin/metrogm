"VertexLitGeneric"
{
	"$basetexture" "models/2k_int/5402_default_int_addon"
	"$model" "1"

	"$phong" "1"
	"$bumpmap"				"models/2k_int/5402_default_int_addon_n"
	"$phongboost"				1
	"$phongfresnelranges"		"[1 1 1]"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .2 .2 .2 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
	"$envmapFresnel" "1"
	$normalmapalphaenvmapmask 1
	
	"$rimlight" "1"
	"$rimlightexponent" "1"
	"$rimlightboost" "3"
	"$rimmask" "1"
	

	"Proxies"
	{
		TrainBodyColor
		{
			resultVar	$color2
		}
		TrainBodyDecal
		{
			resultVar	$detailblendfactor
		}
	}
