"VertexLitGeneric"
{
	"$basetexture" "models/2k_int/5402k_default_mask"
	"$model" "1"

	"$phong" "1"
	"$bumpmap"				"models/metrostroi_train/81-5402/5402_4_n"
	"$phongboost"				1
	"$phongfresnelranges"		"[1 1 1]"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .01 .01 .01 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
	"$envmapFresnel" "1"
	$normalmapalphaenvmapmask 1
	
	"$rimlight" "1"
	"$rimlightexponent" "1"
	"$rimlightboost" "3"
	"$rimmask" "1"
	
	
	"Proxies"
	{
		TrainBodyColor
		{
			resultVar	$color2
		}
		TrainBodyDecal
		{
			resultVar	$detailblendfactor
		}
	}
}

