"VertexLitGeneric"
{
	"$basetexture" "models/2k_int/krutilka"
	"$model" "1"

	"$bumpmap"				"models/2k_int/krutilka_n"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .01 .01 .01 ]"
	"$envmapsaturation" ".01"
	"$envmapcontrast" "0.1"
	"$envmapFresnel" "1"
	$normalmapalphaenvmapmask 1
	
	"$rimlight" "1"
	"$rimlightexponent" "1"
	"$rimlightboost" "3"
	"$rimmask" "1"
}